{
  "name": "@teams.sdk/common",
  "version": "0.1.16",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/aacebo/teams-sdk-js",
  "bugs": "https://github.com/aacebo/teams-sdk-js/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aacebo/teams-sdk-js.git",
    "directory": "packages/common"
  },
  "keywords": [
    "microsoft",
    "teams",
    "msteams",
    "copilot",
    "ai",
    "common"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events/index.d.mts",
        "default": "./dist/events/index.mjs"
      },
      "require": {
        "types": "./dist/events/index.d.ts",
        "default": "./dist/events/index.js"
      }
    },
    "./logging": {
      "import": {
        "types": "./dist/logging/index.d.mts",
        "default": "./dist/logging/index.mjs"
      },
      "require": {
        "types": "./dist/logging/index.d.ts",
        "default": "./dist/logging/index.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.mts",
        "default": "./dist/storage/index.mjs"
      },
      "require": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      }
    }
  },
  "scripts": {
    "clean": "npx rimraf ./dist",
    "build": "npx tsup",
    "test": "npx jest"
  },
  "devDependencies": {
    "@teams.sdk/config": "*",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.2.4",
    "typescript": "^5.4.5"
  }
}
