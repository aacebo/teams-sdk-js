    "@teams.sdk/cards": "latest",
    "@teams.sdk/client": "latest",
    "@teams.sdk/common": "latest",
    "@teams.sdk/dev": "latest",
    "@teams.sdk/graph": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.4.5",
    "vite": "^6.2.0"
  }
}
